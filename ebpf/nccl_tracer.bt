#!/usr/bin/env bpftrace

BEGIN {
    printf("%-10s %-16s %-6s %-20s %s\n",
           "TIME(us)", "EVENT", "PID", "COMM", "DETAIL");
    printf("%-10s %-16s %-6s %-20s %s\n",
           "--------", "-----", "---", "----", "------");
}

fentry:rdma_rxe:rxe_modify_qp {
    $state = args->attr->qp_state;
    if ($state == 1) {
        printf("%-10llu %-16s %-6d %-20s %s\n",
               elapsed / 1000, "modify_qp", pid, comm, "RESET->INIT");
    } else if ($state == 2) {
        printf("%-10llu %-16s %-6d %-20s %s\n",
               elapsed / 1000, "modify_qp", pid, comm, "INIT->RTR");
    } else if ($state == 3) {
        printf("%-10llu %-16s %-6d %-20s %s\n",
               elapsed / 1000, "modify_qp", pid, comm, "RTR->RTS");
    }
}

fentry:rdma_rxe:rxe_post_send {
    @send_start[pid] = nsecs;
    @send_count[pid] = @send_count[pid] + 1;
    printf("%-10llu %-16s %-6d %-20s step=%d\n",
           elapsed / 1000,
           "post_send",
           pid,
           comm,
           @send_count[pid]);
}

fentry:rdma_rxe:rxe_post_recv {
    printf("%-10llu %-16s %-6d %-20s\n",
           elapsed / 1000,
           "post_recv",
           pid,
           comm);
}

fentry:rdma_rxe:rxe_poll_cq {
    $start = @send_start[pid];
    if ($start > 0) {
        $latency_us = (nsecs - $start) / 1000;
        printf("%-10llu %-16s %-6d %-20s latency=%llu us\n",
               elapsed / 1000,
               "poll_cq",
               pid,
               comm,
               $latency_us);
        @send_start[pid] = 0;
        @latency_hist = hist($latency_us);
    }
}

END {
    printf("\n=== Send-to-Completion Latency Histogram (us) ===\n");
    print(@latency_hist);
    clear(@send_start);
    clear(@send_count);
    clear(@latency_hist);
}